# OpenRouter (https://openrouter.ai/keys). The model must support image input and structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Database: local file by default, or a Turso/libSQL URL when hosted
DATABASE_URL=file:handshake.db
DATABASE_AUTH_TOKEN=

# Public base URL used in share links
APP_URL=http://localhost:3000

# Handshake platform fee kept from each release (percent)
PLATFORM_FEE_PERCENT=5

# Shows the client/freelancer role switcher on job pages (for judges)
DEMO_MODE=true

# One-click demo for judges (sandbox only: these are fake-money test accounts)
# Payer login shown on demo jobs: a Personal account from developer.paypal.com > Testing Tools > Sandbox Accounts
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# Payout receiver for demo jobs: a sandbox Business account that is NOT the one owning your app's credentials
DEMO_FREELANCER_EMAIL=
