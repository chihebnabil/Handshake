# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Database: local file by default, or a Turso/libSQL URL when hosted
DATABASE_URL=file:handshake.db
DATABASE_AUTH_TOKEN=

# Public base URL used in share links
APP_URL=http://localhost:3000

# Handshake platform fee kept from each release (percent)
PLATFORM_FEE_PERCENT=5

# Shows the client/freelancer role switcher on job pages (for judges)
DEMO_MODE=true
